{
  "name": "moshpit",
  "private": true,
  "sideEffects": ["./src/zod-config.ts", "./src/lib/moshpit/setup-link.ts"],
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080",
    "build": "vite build",
    "build:spa": "vite build --config vite.spa.ts",
    "build:release": "node scripts/build-release.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "bridge": "node bridge/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:bridge && npm run test:e2e",
    "verify:pwa": "npm run build && node .agents/skills/verify-moshpit/helpers/check-pwa.mjs",
    "verify:live-detail": "npm run build:spa && node .agents/skills/verify-moshpit/helpers/check-live-detail.mjs",
    "verify:upload": "npm run build && node .agents/skills/verify-moshpit/helpers/check-upload.mjs",
    "verify:chat-upload": "node .agents/skills/verify-moshpit/helpers/check-chat-upload.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "verify:session-review": "node --test bridge/submissions.test.mjs bridge/write-routing.test.mjs bridge/sessions.test.mjs bridge/native-input.test.mjs && node .agents/skills/verify-moshpit/helpers/check-session-review.mjs",
    "test:node": "node scripts/node-checks.mjs",
    "test:bridge": "node --test bridge/*.test.mjs",
    "test:release": "npm run build:release && MOSHPIT_TEST_BRIDGE_BIN=\"$PWD/dist/release/moshpit-linux-$(node -p process.arch)\" node --test bridge/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:webkit": "scripts/e2e-webkit.sh",
    "ci": "npm run typecheck && npm run lint && npm run test:bridge && npm run test:release && playwright test --project=phone --project=desktop --project=security-firefox --project=lifecycle-firefox --retries=2 && npm run test:e2e:webkit -- --retries=2"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lobehub/icons-static-svg": "^1.95.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/router-plugin": "^1.168.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.510.0",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "request-filtering-agent": "^3.2.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "zod": "^4.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsqr": "1.4.0",
    "lightningcss": "^1.28.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.0"
  }
}
