# Copy to deploy/bridge.env and edit, or run: scripts/bridge.sh init
#
# Plain KEY=VALUE only: this file is read both by `set -a; source` in
# scripts/bridge.sh and by systemd's EnvironmentFile, and systemd does no
# shell expansion. No quotes, no $VAR, no command substitution.

# tailscale, password, or tailscale+password.
MOSHPIT_AUTH_MODE=tailscale

# tailscale modes: the exact Serve login this bridge answers.
MOSHPIT_TRUSTED_USER=you@example.com

# password modes instead: a 0600 file owned by the bridge user.
#MOSHPIT_PASSWORD_FILE=/home/you/.config/moshpit/password

MOSHPIT_HERDR_BIN=/usr/bin/herdr

# Loopback port the bridge listens on. Tailscale Serve proxies to it.
MOSHPIT_PORT=8801

# The exact origin browsers open, and the Host authority Serve forwards.
MOSHPIT_PUBLIC_ORIGIN=https://your-host.your-tailnet.ts.net:8803
MOSHPIT_ALLOWED_AUTHORITIES=your-host.your-tailnet.ts.net:8803

# Absolute, so the service does not depend on the working directory.
MOSHPIT_STATE_DIR=/path/to/moshpit/.moshpit-state

# Optional: enables Conversation for OpenCode agents.
#MOSHPIT_SESSION_REGISTRY=/home/you/.config/herdr/moshpit-sessions.json
